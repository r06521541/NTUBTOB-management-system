{
  "openapi": "3.1.0",
  "info": {
    "title": "NTUBTOB Mobile API",
    "version": "1.0.0",
    "description": "Canonical native contract. Basic remains isolated; bounded Officer/Admin reads are projected from the fresh active Person principal. Tokens, provider assertions, nonces, idempotency keys and secrets are redacted from logs and error responses."
  },
  "servers": [{"url": "/api/v1"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/auth/line/exchange": {
      "post": {
        "security": [],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LineExchangeRequest"}}}},
        "responses": {"201": {"description": "Device session created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SessionEnvelope"}}}}, "202": {"description": "Pending identity; review-only credential issued and no mobile session created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PendingReviewEnvelope"}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/IdentityUnavailable"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/Validation"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}}
      }
    },
    "/auth/google/exchange": {
      "post": {
        "security": [],
        "description": "Accepts only a raw Google ID token. The backend verifies signature, Google issuer, expiry and an explicitly configured audience allowlist, then uses only verified sub as provider_subject. Email, name and avatar are not identity assertions and are not accepted.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GoogleExchangeRequest"}}}},
        "responses": {"201": {"description": "Device session created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SessionEnvelope"}}}}, "202": {"description": "Pending identity; review-only credential issued and no mobile session created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PendingReviewEnvelope"}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/IdentityUnavailable"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/Validation"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}}
      }
    },
    "/auth/identities": {
      "get": {"description": "List only safe provider labels and linked_at for the current Person; sensitive provider data is never returned.", "responses": {"200": {"description": "Redacted linked login methods"}, "401": {"$ref": "#/components/responses/Unauthenticated"}}}
    },
    "/auth/identity-link/candidates/{provider}": {
      "post": {"security": [], "description": "Verify an explicitly selected provider credential and issue a purpose-separated candidate credential for at most 300 seconds. The credential alone has no access or review authority.", "parameters": [{"$ref": "#/components/parameters/IdentityProvider"}], "responses": {"201": {"description": "Candidate proof created"}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/Validation"}}}
    },
    "/auth/identity-link/proofs/{provider}": {
      "post": {"security": [], "description": "Freshly verify the other linked active provider and bind it to the candidate transaction.", "parameters": [{"$ref": "#/components/parameters/IdentityProvider"}], "responses": {"201": {"description": "Fresh proof created"}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "409": {"$ref": "#/components/responses/Conflict"}}}
    },
    "/auth/identity-link/confirm": {
      "post": {"security": [], "description": "Explicit atomic cross-provider confirmation. Recovery returns a session only on the first successful confirmation; a lost-response replay returns already_linked without a second session.", "responses": {"200": {"description": "Linked or idempotently already linked"}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/Validation"}}}
    },
    "/auth/identity-link/cancel": {
      "post": {"security": [], "description": "Cancel only this device flow and clear client-held state. The bounded harmless server proof expires within 300 seconds.", "responses": {"200": {"description": "Cancelled on this device"}}}
    },
    "/auth/refresh": {
      "post": {
        "security": [],
        "parameters": [{"$ref": "#/components/parameters/RefreshAttemptId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RefreshRequest"}}}},
        "responses": {"200": {"description": "Rotated session envelope; same attempt and request replays exactly for 300 seconds", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SessionEnvelope"}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/Validation"}, "503": {"$ref": "#/components/responses/Unavailable"}}
      }
    },
    "/auth/logout": {
      "post": {"responses": {"204": {"description": "Current device session revoked idempotently"}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "503": {"$ref": "#/components/responses/Unavailable"}}}
    },
    "/me": {
      "get": {"responses": {"200": {"description": "Active Person and request-time server-computed capabilities", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Person"}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/Forbidden"}, "503": {"$ref": "#/components/responses/Unavailable"}}},
      "patch": {"parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["display_name"], "properties": {"display_name": {"type": "string", "minLength": 1, "maxLength": 120}}}}}}, "responses": {"200": {"description": "Refreshed self Person with truthful changed and idempotent_replay", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileMutation"}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/Validation"}}}
    },
    "/auth/line/review": {
      "get": {"description": "Read only the pending identity bound to the review credential", "responses": {"200": {"description": "Own pending review", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PendingReview"}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}}}
    },
    "/auth/line/review/messages": {
      "post": {"parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["body"], "properties": {"body": {"type": "string", "minLength": 1, "maxLength": 1000}}}}}}, "responses": {"200": {"description": "Applicant message appended within server rate limit", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PendingReview"}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/Validation"}}}
    },
    "/games": {
      "get": {
        "parameters": [{"name": "cursor", "in": "query", "schema": {"type": ["string", "null"], "maxLength": 256}, "description": "Opaque cursor; null starts at earliest start_at, id ascending."}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}}],
        "responses": {"200": {"description": "Scoped future invited games", "content": {"application/json": {"schema": {"type": "object", "required": ["items", "next_cursor"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Game"}}, "next_cursor": {"type": ["string", "null"]}}}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/Forbidden"}, "503": {"$ref": "#/components/responses/Unavailable"}}}
    },
    "/games/{game_id}": {
      "get": {"parameters": [{"$ref": "#/components/parameters/GameId"}], "responses": {"200": {"description": "Scoped game detail", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Game"}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}, "503": {"$ref": "#/components/responses/Unavailable"}}}
    },
    "/events": {
      "get": {
        "description": "List only non-ended published or cancelled Events whose immutable invitee snapshot includes the active Person.",
        "parameters": [{"name": "cursor", "in": "query", "schema": {"type": ["string", "null"], "maxLength": 256}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}}],
        "responses": {"200": {"description": "Principal-scoped Event page without invitees, eligibility, manager, audit or attendance data", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["items", "next_cursor"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Event"}}, "next_cursor": {"type": ["string", "null"], "maxLength": 256}}}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/Forbidden"}, "422": {"$ref": "#/components/responses/Validation"}, "503": {"$ref": "#/components/responses/Unavailable"}}
      }
    },
    "/events/{event_id}": {
      "get": {"description": "Read one Event through the same immutable included-invitee scope. Draft, excluded and otherwise invisible resources return the same 404.", "parameters": [{"$ref": "#/components/parameters/EventId"}], "responses": {"200": {"description": "Principal-scoped Event detail", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Event"}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}, "503": {"$ref": "#/components/responses/Unavailable"}}}
    },
    "/games/{game_id}/attendance": {
      "get": {"parameters": [{"$ref": "#/components/parameters/GameId"}], "responses": {"200": {"description": "Own reply plus only People who replied; no unreplied roster, provider subject, contact, admin note or audit data", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AttendanceRead"}, "examples": {"basic": {"value": {"game_id": "game_44", "own_reply": "undecided", "replied": [{"person_id": "person_23", "display_name": "測試球員", "reply": "attending", "qualification": "team_player"}]}}}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}, "503": {"$ref": "#/components/responses/Unavailable"}}}
    },
    "/games/{game_id}/attendance-report": {
      "get": {
        "parameters": [{"$ref": "#/components/parameters/GameId"}, {"name": "history_limit", "in": "query", "schema": {"type": "integer", "enum": [5, 8, 12, 20], "default": 12}}, {"name": "minimum_response_rate", "in": "query", "schema": {"type": "integer", "minimum": 0, "maximum": 100, "multipleOf": 10, "default": 60}}],
        "responses": {"200": {"description": "Officer/Admin low-sensitive report for a Game already visible to the active Person. Observation counts and thresholds describe bounded history; no identity subject, contact, admin note or audit data.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AttendanceReport"}, "examples": {"empty": {"value": {"game_id": "game_44", "generated_at": "2026-08-18T12:00:00Z", "observation": {"history_games": 8, "history_limit": 12, "minimum_response_rate": 60}, "attending": [], "not_attending": [], "not_yet_replied": []}}}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}, "422": {"$ref": "#/components/responses/Validation"}, "503": {"$ref": "#/components/responses/Unavailable"}}
      }
    },
    "/games/{game_id}/attendance-reply": {
      "put": {
        "parameters": [{"$ref": "#/components/parameters/GameId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["reply"], "properties": {"reply": {"$ref": "#/components/schemas/AttendanceReply"}}}}}},
        "responses": {"200": {"description": "Durable saved-state result. changed=false never notifies. A recovered pending claim may return changed=null and notification.status=unknown because saved attendance is proven but the pre-crash notification outcome cannot be reconstructed; reconcile with GET attendance. expected_version is intentionally absent.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AttendanceMutation"}, "examples": {"notificationPartialFailure": {"value": {"game_id": "game_44", "reply": "arriving_late", "changed": true, "updated_at": "2026-08-18T10:00:00Z", "notification": {"status": "failed", "code": "attendance_notification_failed"}, "idempotent_replay": false}}}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/Validation"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}}
      }
    },
    "/notifications": {
      "get": {
        "description": "List only notifications assigned to the server-derived Person principal with visibility fixed at exactly 90 days. Opaque keyset order is created_at and notification_id descending.",
        "parameters": [{"name": "cursor", "in": "query", "schema": {"type": ["string", "null"], "maxLength": 256}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}}, {"name": "unread_only", "in": "query", "schema": {"type": "boolean", "default": false}}],
        "responses": {"200": {"description": "Principal-scoped notification page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotificationPage"}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/Forbidden"}, "422": {"$ref": "#/components/responses/Validation"}, "503": {"$ref": "#/components/responses/Unavailable"}}
      }
    },
    "/notifications/unread-count": {
      "get": {
        "description": "Count unread, unexpired notifications for the server-derived Person principal.",
        "responses": {"200": {"description": "Current unread badge count", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["unread_count"], "properties": {"unread_count": {"type": "integer", "minimum": 0}}}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/Forbidden"}, "503": {"$ref": "#/components/responses/Unavailable"}}
      }
    },
    "/notifications/{notification_id}": {
      "get": {
        "description": "Detail is visible only to its server-derived Person principal; another recipient or expired row is the same nonleaking 404.",
        "parameters": [{"$ref": "#/components/parameters/NotificationId"}],
        "responses": {"200": {"description": "Notification detail", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Notification"}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}, "503": {"$ref": "#/components/responses/Unavailable"}}
      }
    },
    "/notifications/{notification_id}/read": {
      "put": {
        "description": "Idempotent mark-read for one visible notification owned by the server-derived Person principal.",
        "parameters": [{"$ref": "#/components/parameters/NotificationId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "maxProperties": 0}}}},
        "responses": {"200": {"description": "Durable read state; replay returns changed=false and the original read_at", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotificationReadResult"}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}, "422": {"$ref": "#/components/responses/Validation"}, "503": {"$ref": "#/components/responses/Unavailable"}}
      }
    },
    "/notifications/read-all": {
      "put": {
        "description": "Idempotent mark-all-read for every unread and unexpired row owned by the server-derived Person principal.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "maxProperties": 0}}}},
        "responses": {"200": {"description": "Changed count is zero on replay", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotificationReadAllResult"}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/Forbidden"}, "422": {"$ref": "#/components/responses/Validation"}, "503": {"$ref": "#/components/responses/Unavailable"}}
      }
    },
    "/officer/notifications/preview": {
      "post": {
        "description": "Requires the exact notifications:publish capability. The server expands individual, game or team recipients and returns only a bounded count, exact revision and typed confirmation text; preview is not authorization.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotificationDraft"}}}},
        "responses": {"200": {"description": "Server-owned recipient preview", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotificationPreview"}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/Validation"}, "503": {"$ref": "#/components/responses/Unavailable"}}
      }
    },
    "/officer/notifications/confirm": {
      "post": {
        "description": "Revalidates capability and exact recipient revision. One transaction commits durable in-app content, recipients, immutable audit, in-app success and push outbox independently of external delivery. No real provider is invoked.",
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotificationConfirm"}}}},
        "responses": {"200": {"description": "Exact idempotent replay", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotificationPublishResult"}}}}, "201": {"description": "Notification durably published", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotificationPublishResult"}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/Validation"}, "503": {"$ref": "#/components/responses/Unavailable"}}
      }
    },
    "/devices/current": {
      "put": {
        "description": "Locks and verifies the current active Person/session/installation, then idempotently registers only a uniquely owned explicit fake provider token hash; ownership conflicts are bounded and real APNs/FCM tokens are rejected.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DeviceRegistrationRequest"}}}},
        "responses": {"200": {"description": "Active fake registration", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DeviceRegistration"}}}}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/Validation"}, "503": {"$ref": "#/components/responses/Unavailable"}}
      },
      "delete": {
        "description": "Idempotently revokes the current Person installation registration.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["installation_id"], "properties": {"installation_id": {"type": "string", "minLength": 16, "maxLength": 200}}}}}},
        "responses": {"200": {"description": "Revocation result"}, "401": {"$ref": "#/components/responses/Unauthenticated"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/Validation"}, "503": {"$ref": "#/components/responses/Unavailable"}}
      }
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "short-lived app access token", "description": "Authorization header only; never cookie/query. Access TTL 900 seconds and maximum token length 4096 bytes."}},
    "parameters": {
      "IdentityProvider": {"name": "provider", "in": "path", "required": true, "schema": {"type": "string", "enum": ["line", "google"]}},
      "GameId": {"name": "game_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 64}, "description": "Opaque server ID."},
      "EventId": {"name": "event_id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^event_[1-9][0-9]*$", "maxLength": 26}, "description": "Opaque Event identifier backed by a positive PostgreSQL signed bigint."},
      "NotificationId": {"name": "notification_id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^notification_[1-9][0-9]*$", "maxLength": 32}, "description": "Opaque notification identifier backed by a positive PostgreSQL signed bigint."},
      "RefreshAttemptId": {"name": "Refresh-Attempt-ID", "in": "header", "required": true, "schema": {"type": "string", "minLength": 16, "maxLength": 200}, "description": "One ID per refresh attempt; exact replay grace 300 seconds; persisted only as a hash."},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 16, "maxLength": 200}, "description": "One key per confirmed logical mutation; terminal result retention 86400 seconds; persisted only as a hash."}
    },
    "schemas": {
      "AttendanceReply": {"type": "string", "enum": ["attending", "not_attending", "arriving_late", "leaving_early", "undecided"]},
      "NotificationType": {"type": "string", "enum": ["game_reminder", "attendance_reminder", "game_change", "officer_personal", "officer_game_broadcast", "officer_team_broadcast", "admin_system_announcement"]},
      "LineExchangeRequest": {"type": "object", "additionalProperties": false, "required": ["id_token", "nonce", "login_attempt_id", "installation_id", "platform"], "properties": {"id_token": {"type": "string", "minLength": 1, "maxLength": 2048, "writeOnly": true}, "nonce": {"type": "string", "minLength": 16, "maxLength": 200, "writeOnly": true}, "login_attempt_id": {"type": "string", "minLength": 16, "maxLength": 200}, "installation_id": {"type": "string", "minLength": 16, "maxLength": 200}, "platform": {"type": "string", "enum": ["ios", "android"]}}},
      "GoogleExchangeRequest": {"type": "object", "additionalProperties": false, "required": ["id_token", "login_attempt_id", "installation_id", "platform"], "properties": {"id_token": {"type": "string", "minLength": 1, "maxLength": 2048, "writeOnly": true}, "login_attempt_id": {"type": "string", "minLength": 16, "maxLength": 200}, "installation_id": {"type": "string", "minLength": 16, "maxLength": 200}, "platform": {"type": "string", "enum": ["ios", "android"]}}},
      "RefreshRequest": {"type": "object", "additionalProperties": false, "required": ["refresh_token", "installation_id"], "properties": {"refresh_token": {"type": "string", "minLength": 32, "maxLength": 2048, "writeOnly": true}, "installation_id": {"type": "string", "minLength": 16, "maxLength": 200}}},
      "SessionEnvelope": {"type": "object", "additionalProperties": false, "required": ["access_token", "refresh_token", "session_id", "expires_in"], "properties": {"access_token": {"type": "string", "writeOnly": true}, "refresh_token": {"type": "string", "writeOnly": true}, "session_id": {"type": "string", "maxLength": 64}, "expires_in": {"type": "integer", "const": 900}}},
      "PendingReviewEnvelope": {"type": "object", "additionalProperties": false, "required": ["review_credential", "expires_in", "status"], "properties": {"review_credential": {"type": "string", "writeOnly": true}, "expires_in": {"type": "integer", "const": 600}, "status": {"const": "pending"}}},
      "PendingReview": {"type": "object", "additionalProperties": false, "required": ["status", "messages"], "properties": {"status": {"const": "pending"}, "messages": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "sender", "body", "created_at", "redacted"], "properties": {"id": {"type": "string"}, "sender": {"type": "string", "enum": ["applicant", "admin"]}, "body": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}, "redacted": {"type": "boolean"}}}}}},
      "ProfileMutation": {"type": "object", "additionalProperties": false, "required": ["person", "changed", "idempotent_replay"], "properties": {"person": {"$ref": "#/components/schemas/Person"}, "changed": {"type": "boolean"}, "idempotent_replay": {"type": "boolean"}}},
      "Person": {"type": "object", "additionalProperties": false, "required": ["id", "display_name", "access_level", "capabilities"], "properties": {"id": {"type": "string", "maxLength": 64}, "display_name": {"type": "string", "maxLength": 120}, "access_level": {"type": "string", "enum": ["basic", "officer", "admin"]}, "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["games:read", "events:read", "attendance:reply:self", "notifications:read", "attendance:report:read", "notifications:publish"]}}}},
      "NotificationDestination": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["type", "notification_id"], "properties": {"type": {"const": "notification"}, "notification_id": {"type": "string", "pattern": "^notification_[1-9][0-9]*$"}}}, {"type": "object", "additionalProperties": false, "required": ["type", "game_id"], "properties": {"type": {"const": "game"}, "game_id": {"type": "string", "pattern": "^game_-?[1-9][0-9]*$", "maxLength": 25}}}], "description": "Typed identifier only. Unknown, malformed, out-of-range, unauthorized or expired destinations safely fall back to the notification list."},
      "Notification": {"type": "object", "additionalProperties": false, "required": ["id", "type", "title", "body", "created_at", "visible_until", "read_at", "destination"], "properties": {"id": {"type": "string", "pattern": "^notification_[1-9][0-9]*$", "maxLength": 32}, "type": {"$ref": "#/components/schemas/NotificationType"}, "title": {"type": "string", "minLength": 1, "maxLength": 120}, "body": {"type": "string", "minLength": 1, "maxLength": 500, "description": "Plain text only."}, "created_at": {"type": "string", "format": "date-time"}, "visible_until": {"type": "string", "format": "date-time", "description": "Exactly created_at plus 90 days; earlier or later expiry is invalid."}, "read_at": {"type": ["string", "null"], "format": "date-time"}, "destination": {"$ref": "#/components/schemas/NotificationDestination"}}},
