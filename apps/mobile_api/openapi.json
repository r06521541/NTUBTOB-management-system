      "DeviceRegistrationRequest": {"type": "object", "additionalProperties": false, "required": ["installation_id", "platform", "provider", "token"], "properties": {"installation_id": {"type": "string", "minLength": 16, "maxLength": 200}, "platform": {"type": "string", "enum": ["ios", "android"]}, "provider": {"const": "fake"}, "token": {"type": "string", "pattern": "^fake-device-token-", "minLength": 32, "maxLength": 500, "writeOnly": true}}},
