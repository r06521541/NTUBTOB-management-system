      "NotificationDraft": {"type": "object", "additionalProperties": false, "required": ["type", "title", "body", "audience", "destination"], "properties": {"type": {"type": "string", "enum": ["officer_personal", "officer_game_broadcast", "officer_team_broadcast"]}, "title": {"type": "string", "minLength": 1, "maxLength": 120}, "body": {"type": "string", "minLength": 1, "maxLength": 500, "description": "Plain text only."}, "audience": {"$ref": "#/components/schemas/NotificationAudience"}, "destination": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "notification"}}}, {"type": "object", "additionalProperties": false, "required": ["type", "game_id"], "properties": {"type": {"const": "game"}, "game_id": {"type": "string", "pattern": "^game_-?[1-9][0-9]*$", "maxLength": 25}}}]}}},
      "NotificationPreview": {"type": "object", "additionalProperties": false, "required": ["draft", "recipient_count", "revision", "confirmation_text"], "properties": {"draft": {"$ref": "#/components/schemas/NotificationDraft"}, "recipient_count": {"type": "integer", "minimum": 1, "maximum": 500}, "revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "confirmation_text": {"type": "string", "pattern": "^PUBLISH [1-9][0-9]{0,2}$"}}},
      "NotificationConfirm": {"type": "object", "additionalProperties": false, "required": ["draft", "preview_revision", "typed_confirmation"], "properties": {"draft": {"$ref": "#/components/schemas/NotificationDraft"}, "preview_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "typed_confirmation": {"type": "string", "maxLength": 11}}},
