      "NotificationReadResult": {"type": "object", "additionalProperties": false, "required": ["notification_id", "read_at", "changed"], "properties": {"notification_id": {"type": "string", "pattern": "^notification_[1-9][0-9]*$", "maxLength": 32}, "read_at": {"type": "string", "format": "date-time"}, "changed": {"type": "boolean"}}},
      "NotificationReadAllResult": {"type": "object", "additionalProperties": false, "required": ["changed_count", "unread_count"], "properties": {"changed_count": {"type": "integer", "minimum": 0}, "unread_count": {"type": "integer", "minimum": 0, "description": "May be nonzero only when a newly assigned notification races with mark-all."}}},
      "Game": {"type": "object", "additionalProperties": false, "required": ["id", "start_at", "duration_minutes", "location", "home_team", "away_team"], "properties": {"id": {"type": "string", "maxLength": 64}, "start_at": {"type": "string", "format": "date-time", "description": "RFC3339 UTC on the wire."}, "duration_minutes": {"type": ["integer", "null"]}, "location": {"type": ["string", "null"], "maxLength": 300}, "home_team": {"type": ["string", "null"], "maxLength": 200}, "away_team": {"type": ["string", "null"], "maxLength": 200}}},
      "EventActivity": {"type": "object", "additionalProperties": false, "required": ["id", "title", "type", "position", "start_at", "end_at", "linked_game_id"], "properties": {"id": {"type": "string", "pattern": "^activity_[1-9][0-9]*$", "maxLength": 29}, "title": {"type": "string", "minLength": 1, "maxLength": 200}, "type": {"type": "string", "enum": ["game", "meal", "transport", "lodging", "gathering", "other"]}, "position": {"type": "integer"}, "start_at": {"type": "string", "format": "date-time"}, "end_at": {"type": ["string", "null"], "format": "date-time"}, "linked_game_id": {"type": ["string", "null"], "pattern": "^game_-?[1-9][0-9]*$", "maxLength": 25, "description": "Canonical game_<signed> identifier using a nonzero signed 64-bit integer, present only when the linked Game independently passes the current principal's existing Game read scope."}}},
      "Event": {"type": "object", "additionalProperties": false, "required": ["id", "title", "type", "status", "start_at", "end_at", "activities"], "properties": {"id": {"type": "string", "pattern": "^event_[1-9][0-9]*$", "maxLength": 26}, "title": {"type": "string", "minLength": 1, "maxLength": 200}, "type": {"type": "string", "enum": ["game", "meal", "trip", "practice", "social", "other"]}, "status": {"type": "string", "enum": ["published", "cancelled"]}, "start_at": {"type": "string", "format": "date-time"}, "end_at": {"type": ["string", "null"], "format": "date-time"}, "activities": {"type": "array", "items": {"$ref": "#/components/schemas/EventActivity"}}}},
      "AttendanceRead": {"type": "object", "additionalProperties": false, "required": ["game_id", "own_reply", "replied"], "properties": {"game_id": {"type": "string"}, "own_reply": {"anyOf": [{"$ref": "#/components/schemas/AttendanceReply"}, {"type": "null"}]}, "replied": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["person_id", "display_name", "reply", "qualification"], "properties": {"person_id": {"type": "string"}, "display_name": {"type": "string", "maxLength": 120}, "reply": {"$ref": "#/components/schemas/AttendanceReply"}, "qualification": {"type": "string", "enum": ["team_player", "guest_player"]}}}}}},
      "AttendanceReportPerson": {"type": "object", "additionalProperties": false, "required": ["person_id", "display_name", "reply"], "properties": {"person_id": {"type": "string"}, "display_name": {"type": "string", "maxLength": 120}, "reply": {"$ref": "#/components/schemas/AttendanceReply"}, "member_number": {"type": ["integer", "null"], "minimum": 0, "maximum": 999, "description": "Optional existing Member number; omitted by legacy producers and never an authorization signal."}}},
      "AttendanceReportUnansweredPerson": {"type": "object", "additionalProperties": false, "required": ["person_id", "display_name", "observed_replies", "observed_games", "response_rate", "participation_rate", "nonparticipation_rate"], "properties": {"person_id": {"type": "string"}, "display_name": {"type": "string", "maxLength": 120}, "observed_replies": {"type": "integer", "minimum": 1}, "observed_games": {"type": "integer", "minimum": 1}, "response_rate": {"type": "integer", "minimum": 0, "maximum": 100}, "participation_rate": {"type": "integer", "minimum": 0, "maximum": 100}, "nonparticipation_rate": {"type": "integer", "minimum": 0, "maximum": 100}}},
      "AttendanceReport": {"type": "object", "additionalProperties": false, "required": ["game_id", "generated_at", "observation", "attending", "not_attending", "not_yet_replied"], "properties": {"game_id": {"type": "string"}, "generated_at": {"type": "string", "format": "date-time"}, "observation": {"type": "object", "additionalProperties": false, "required": ["history_games", "history_limit", "minimum_response_rate"], "properties": {"history_games": {"type": "integer", "minimum": 0}, "history_limit": {"type": "integer", "enum": [5, 8, 12, 20]}, "minimum_response_rate": {"type": "integer", "minimum": 0, "maximum": 100, "multipleOf": 10}}}, "attending": {"type": "array", "items": {"$ref": "#/components/schemas/AttendanceReportPerson"}}, "not_attending": {"type": "array", "items": {"$ref": "#/components/schemas/AttendanceReportPerson"}}, "not_yet_replied": {"type": "array", "items": {"$ref": "#/components/schemas/AttendanceReportUnansweredPerson"}}}},
      "AttendanceMutation": {"type": "object", "additionalProperties": false, "required": ["game_id", "reply", "changed", "updated_at", "notification", "idempotent_replay"], "properties": {"game_id": {"type": "string"}, "reply": {"$ref": "#/components/schemas/AttendanceReply"}, "changed": {"type": ["boolean", "null"]}, "updated_at": {"type": "string", "format": "date-time"}, "notification": {"type": "object", "additionalProperties": false, "required": ["status", "code"], "properties": {"status": {"type": "string", "enum": ["not_required", "succeeded", "failed", "unknown"]}, "code": {"type": ["string", "null"], "enum": ["attendance_notification_failed", "attendance_notification_outcome_unknown", null]}}}, "idempotent_replay": {"type": "boolean"}}},
      "Error": {"type": "object", "additionalProperties": false, "required": ["error"], "properties": {"error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "request_id", "retryable", "retry_after_seconds", "field_errors"], "properties": {"code": {"type": "string", "enum": ["malformed_request", "unauthenticated", "session_expired", "identity_pending", "account_unavailable", "forbidden", "resource_not_found", "idempotency_conflict", "state_conflict", "validation_failed", "rate_limited", "service_unavailable", "server_error"]}, "message": {"type": "string", "maxLength": 300}, "request_id": {"type": "string", "maxLength": 100}, "retryable": {"type": "boolean"}, "retry_after_seconds": {"type": ["integer", "null"], "minimum": 0}, "field_errors": {"type": "array", "maxItems": 20, "items": {"type": "object"}}}}}}
